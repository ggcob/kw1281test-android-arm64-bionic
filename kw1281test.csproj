<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<RootNamespace>BitFab.KW1281Test</RootNamespace>
		<LangVersion>latest</LangVersion>
		<AssemblyVersion>1.0.3.0</AssemblyVersion>
		<FileVersion>1.0.3.0</FileVersion>
		<Version>1.0.3</Version>
		<Copyright>Copyright © 2026 Greg Menounos</Copyright>
		<DebugType>embedded</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
		<Authors>Greg Menounos</Authors>
		<Company>BitFab</Company>
		<PackageProjectUrl>https://github.com/gmenounos/kw1281test</PackageProjectUrl>
		<RepositoryUrl>https://github.com/gmenounos/kw1281test</RepositoryUrl>
		<TrimMode>link</TrimMode>
		<PublishTrimmed>true</PublishTrimmed>
		<SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
		<Nullable>enable</Nullable>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<InternalsVisibleTo>BitFab.KW1281Test.Tests</InternalsVisibleTo>

		<!-- Corrección de alineación a 64KB y enlace estático forzado para Android Bionic -->
		<CustomLinkerArg>-Wl,-z,max-page-size=65536 -Wl,-Bstatic -lm -lpthread -ldl -lc -Wl,-Bdynamic</CustomLinkerArg>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="GitHub\**" />
		<Compile Remove="Tests\**" />
		<EmbeddedResource Remove="GitHub\**" />
		<EmbeddedResource Remove="Tests\**" />
		<None Remove="GitHub\**" />
		<None Remove="Tests\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="EDC15\Loader-EEPROM.bin" />
		<EmbeddedResource Include="EDC15\Loader-sector-erase.bin" />
		<EmbeddedResource Include="EDC15\Loader-flash.bin" />
		<EmbeddedResource Include="EDC15\Loader-boot-stage1.bin" />
		<EmbeddedResource Include="EDC15\Loader-boot-monitor.bin" />
		<EmbeddedResource Include="EDC15\Loader-boot-flash.bin" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.IO.Ports" Version="8.0.0" />
	</ItemGroup>

</Project>
